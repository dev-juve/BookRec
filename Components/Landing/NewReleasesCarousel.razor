@using BookRec.Models
@using BookRec.Services
@inject BookService BookService

<section id="new-releases" class="folio-section" style="background-color: var(--folio-cream);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <span class="eyebrow-tag">FRESH IMPRESSIONS</span>
                <h2 class="display-5 font-serif m-0">Newly Released & Trending</h2>
            </div>
            <a href="#subjects" class="text-decoration-none fw-medium d-none d-sm-inline-flex align-items-center gap-1" style="color: var(--folio-terracotta);">
                View Full Catalog <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var book in DisplayBooks)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="folio-card h-100 d-flex flex-column justify-content-between p-3 bg-white position-relative">
                        @if (book.IsBestseller)
                        {
                            <span class="position-absolute top-0 end-0 m-3 px-2 py-1 rounded small fw-bold" 
                                  style="background-color: rgba(179, 90, 66, 0.1); color: var(--folio-terracotta); font-size: 0.75rem;">
                                ⭐ Bestseller
                            </span>
                        }
                        
                        <div>
                            <div class="bg-light rounded p-3 text-center mb-3 d-flex align-items-center justify-content-center" style="height: 200px;">
                                <img src="@book.CoverImageUrl" class="img-fluid rounded shadow-sm" alt="@book.Title" style="max-height: 170px; object-fit: contain;" />
                            </div>

                        
                            <span class="eyebrow-tag m-0 mb-1" style="font-size: 0.68rem;">@book.Category</span>
                            <h6 class="font-serif fw-bold text-dark mb-1 text-truncate" title="@book.Title">@book.Title</h6>
                            <small class="d-block mb-2" style="color: var(--folio-slate);">by @book.Author</small>
                            <p class="small text-truncate-3 mb-0" style="color: var(--folio-slate); font-size: 0.825rem; line-height: 1.5;">
                                @book.Description
                            </p>
                        </div>

                        <!-- cta -->
                        <div class="mt-3 pt-3 border-top d-grid" style="border-color: var(--folio-sand) !important;">
                            <button class="btn-outline-sand btn-sm text-center py-2 d-flex align-items-center justify-content-center gap-1" 
                                    @onclick="() => BookService.AddToToReadList(book)">
                                <i class="bi bi-plus-lg"></i> Add to To-Read
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public List<Book> DisplayBooks { get; set; } = new();
}

<style>
    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>