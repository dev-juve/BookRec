@rendermode InteractiveServer

@using BookRec.Models
@using BookRec.Services
@inject BookService BookService
@inject UserService UserService

<section id="new-releases" class="folio-section" style="background-color: var(--folio-cream);">
    <div class="container"/>
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <span class="eyebrow-tag">FRESH IMPRESSIONS</span>
                <h2 class="display-5 font-serif m-0">Newly Released & Trending</h2>
            </div>
            <a href="/books" class="text-decoration-none fw-medium d-none d-sm-inline-flex align-items-center gap-1" style="color: var(--folio-terracotta);">
                View Full Catalog <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (addMessage != null) 
        { 
            <div class="alert alert-success mb-4"> 
                @addMessage </div> 
        }

        <div class="row g-4">
            @foreach (var book in DisplayBooks)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="folio-card h-100 d-flex flex-column justify-content-between p-3 bg-white">
                        
                        <div>
                            <div class="book-cover-wrapper rounded p-3 text-center mb-3 d-flex align-items-center justify-content-center">
                                <img src="@book.CoverImageUrl" 
                                     class="book-cover-img rounded" 
                                     alt="@book.Title" />
                            </div>

                            <span class="eyebrow-tag m-0 mb-1" style="font-size: 0.68rem;">@book.Category</span>
                            <h6 class="font-serif fw-bold text-dark mb-1 text-truncate" title="@book.Title">@book.Title</h6>
                            <small class="d-block mb-2" style="color: var(--folio-slate);">by @book.Author</small>
                            <p class="small text-truncate-3 mb-0" style="color: var(--folio-slate); font-size: 0.825rem; line-height: 1.5;">
                                @book.Description
                            </p>
                        </div>

                        <div class="mt-3 pt-3 border-top d-grid" style="border-color: var(--folio-sand) !important;">
                            <button class="btn-outline-sand btn-sm text-center py-2 d-flex align-items-center justify-content-center gap-1" 
                                    @onclick="() => AddToReadingList(book)">
                                <i class="bi bi-plus-lg"></i> Add to To-Read
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
</section>

@code {
    private string? addMessage;

    [Parameter] public List<Book> DisplayBooks { get; set; } = new();

    protected override void OnParametersSet()
    {
        StateHasChanged();
    }

    private async Task AddToReadingList(Book book)
    {
        await UserService.GetUserAsync();

        if (UserService.Id != null)
        {
            await BookService.AddToReadList(book, UserService.Id);
            addMessage = $"\"{book.Title}\" was added to your To-Read list.";
            StateHasChanged();

            await Task.Delay(5000);

            addMessage = null;
            StateHasChanged();
        }
    }
}

<style>
    .book-cover-wrapper {
        background: linear-gradient(145deg, #f3efe6, #faf8f5);
        height: 220px;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.03);
    }

    .book-cover-img {
        max-height: 180px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .folio-card:hover .book-cover-img {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
    }

    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
