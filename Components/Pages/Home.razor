@page "/"
@using BookRec.Models
@using BookRec.Services
@using BookRec.Components.Landing
@inject BookService BookService
@inject GoogleBooksApiService ApiService

<PageTitle>BookRec • Reimagining Book Discovery</PageTitle>

<link rel="stylesheet" href="css/folio-theme.css" />

<div class="folio-landing-wrapper">
    <LandingHeader />

    <HeroSection />

    <CreedBanner />

    <SubjectGrid OnSubjectSelected="HandleSubjectSelected" SelectedCategory="@currentSubject" />

    <NewReleasesCarousel DisplayBooks="recentBooks" />

    <FlowSection />

    <TestimonialsSection />

    <CtaBanner />
</div>

@code {
    private List<Book> recentBooks = new();
    private string currentSubject = "subject:computers";

    protected override async Task OnInitializedAsync()
    {
        recentBooks = BookService.GetAllBooks();
        await LoadBooksForCategory(currentSubject);
    }

    private async Task HandleSubjectSelected(string categoryQuery)
    {
        currentSubject = categoryQuery;
        await LoadBooksForCategory(categoryQuery);
    }

    private async Task LoadBooksForCategory(string categoryQuery)
    {
        var apiBooks = await ApiService.SearchBooksAsync(categoryQuery);
        if (apiBooks != null && apiBooks.Any())
        {
            recentBooks = apiBooks.ToList();
            StateHasChanged();
        }
    }
}