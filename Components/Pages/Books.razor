@page "/books"
@rendermode InteractiveServer
@using BookRec.Services
@using BookRec.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject GoogleBooksApiService GoogleBookService
@inject BookService BookService
@inject NavigationManager Navigation
@inject BookRec.Data.AppDbContext DbContext

<link rel="stylesheet" href="css/folio-theme.css" />

<div class="folio-catalog-wrapper py-4" style="background-color: var(--folio-cream, #faf8f5); min-height: 85vh;">
    <div class="container-fluid max-w-1200">
        
        <!-- header banner -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 border-bottom" style="border-color: var(--folio-sand, #e8e2d5) !important;">
            <div>
                <span class="eyebrow-tag">EXPLORE COLLECTION</span>
                <h1 class="display-6 font-serif fw-bold text-dark m-0">
                    @(string.IsNullOrWhiteSpace(QueryParam) ? "Full Catalog" : $"Results for \"{QueryParam}\"")
                </h1>
            </div>

            <button class="btn btn-outline-dark d-lg-none mt-3 mt-md-0 d-flex align-items-center gap-2 rounded-pill px-3" 
                    type="button" 
                    @onclick="ToggleOffcanvas">
                <i class="bi bi-funnel"></i> Filters & Categories
            </button>
        </div>

        <div class="row g-4">
            
            <!-- desktop sidebar -->
            <aside class="col-lg-3 d-none d-lg-block">
                <div class="p-4 bg-white rounded-3 border sticky-top" style="top: 90px; border-color: var(--folio-sand, #e8e2d5) !important;">
                    @RenderFilterContent()
                </div>
            </aside>

            <!-- main catalog area -->
            <main class="col-12 col-lg-9">
                @if (isLoading)
                {
                    <div class="row g-4">
                        @for (int i = 0; i < 8; i++)
                        {
                            <div class="col-12 col-sm-6 col-md-4">
                                <div class="card border-0 shadow-sm p-3 h-100 placeholder-glow">
                                    <div class="placeholder rounded mb-3" style="height: 180px; width: 100%;"></div>
                                    <div class="placeholder col-4 mb-2"></div>
                                    <div class="placeholder col-8 mb-2"></div>
                                    <div class="placeholder col-6"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (showAllBooks == null || !showAllBooks.Any())
                {
                    <div class="text-center py-5 bg-white rounded-3 border" style="border-color: var(--folio-sand, #e8e2d5) !important;">
                        <i class="bi bi-journal-x fs-1 text-muted mb-2 d-block"></i>
                        <h5 class="fw-bold text-dark">No books found</h5>
                        <p class="text-muted small">Try searching for a different term or clear active filters.</p>
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3" @onclick='() => ApplySearch("a")'>Reset Catalog</button>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 flex-wrap">
                        @foreach (var book in showAllBooks)
                        {
                            <div class="col d-flex align-items-stretch" style="min-width: 0;">
                                <BookCard Book="book" OnAddToToReadList="BookService.AddToReadList" />
                            </div>
                        }
                    </div>

                    <!-- feedback component -->
                    <div class="mt-5 pt-4 border-top text-center" style="border-color: var(--folio-sand, #e8e2d5) !important;">
                        @if (!hasSubmittedFeedback)
                        {
                            <p class="text-muted small mb-3 font-serif" style="font-size: 1rem;">Were these books' recommendations helpful?</p>
                            <div class="d-flex justify-content-center gap-3">
                                <button class="btn btn-outline-success rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm" @onclick="() => SubmitFeedback(true)">
                                    <i class="bi bi-hand-thumbs-up"></i> Yes
                                </button>
                                <button class="btn btn-outline-danger rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm" @onclick="() => SubmitFeedback(false)">
                                    <i class="bi bi-hand-thumbs-down"></i> No
                                </button>
                            </div>
                            
                            <!-- login prompt alert -->
                            @if (showLoginPrompt)
                            {
                                <div class="mt-3 fade-in">
                                    <span class="badge bg-warning text-dark border px-3 py-2 rounded-pill shadow-sm" style="font-weight: 500;">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Please <a href="/signin" class="text-dark fw-bold text-decoration-underline">sign in</a> to leave feedback.
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-success d-flex align-items-center justify-content-center gap-2 py-2 fade-in">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <span class="fw-medium">Thanks for your feedback!</span>
                            </div>
                        }
                    </div>

                    <!-- pagination -->
                    <div class="d-flex align-items-center justify-content-center gap-3 mt-5 pt-3">
                        <button class="btn btn-outline-dark rounded-pill px-4 btn-sm d-flex align-items-center gap-1" 
                                disabled="@(CurrentPage <= 1)" 
                                @onclick="PreviousPage">
                            <i class="bi bi-arrow-left"></i> Previous
                        </button>
                        
                        <span class="fw-bold px-3 py-1 rounded-circle bg-white border small shadow-sm">@CurrentPage</span>
                        
                        <button class="btn btn-outline-dark rounded-pill px-4 btn-sm d-flex align-items-center gap-1" 
                                @onclick="NextPage">
                            Next <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                }
            </main>

        </div>
    </div>
</div>

<!-- mobile offcanvas -->
<div class="offcanvas offcanvas-start @(isOffcanvasOpen ? "show" : "")" 
     tabindex="-1" 
     style="visibility: @(isOffcanvasOpen ? "visible" : "hidden");"
     id="filterOffcanvas" 
     aria-labelledby="filterOffcanvasLabel">
    
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title font-serif fw-bold" id="filterOffcanvasLabel">Filter Catalog</h5>
        <button type="button" class="btn-close" @onclick="CloseOffcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @RenderFilterContent()
    </div>
</div>

@if (isOffcanvasOpen)
{
    <div class="offcanvas-backdrop fade show" @onclick="CloseOffcanvas"></div>
}


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private bool hasSubmittedFeedback = false;
    private bool showLoginPrompt = false; 

    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    private int CurrentPage = 1;
    private bool isLoading = true;
    private List<Book>? showAllBooks;

    protected override async Task OnParametersSetAsync()
    {
        CurrentPage = 1;
        await LoadCatalog();
    }

    private async Task LoadCatalog()
    {
        isLoading = true;
        hasSubmittedFeedback = false; 
        showLoginPrompt = false;
        StateHasChanged();

        var effectiveQuery = string.IsNullOrWhiteSpace(QueryParam) ? "a" : QueryParam;
        
        showAllBooks = await GoogleBookService.SearchBooksAsync(effectiveQuery, CurrentPage);
        
        isLoading = false;
        StateHasChanged();
    }

    private void ApplyCategory(string categoryQuery)
    {
        CloseOffcanvas();
        Navigation.NavigateTo($"/books?q={Uri.EscapeDataString(categoryQuery)}");
    }

    private void ApplySearch(string query)
    {
        CloseOffcanvas();
        Navigation.NavigateTo($"/books?q={Uri.EscapeDataString(query)}");
    }

    private async Task NextPage()
    {
        CurrentPage++;
        await LoadCatalog();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadCatalog();
        }
    }

    private bool isOffcanvasOpen = false;

    private void ToggleOffcanvas()
    {
        isOffcanvasOpen = !isOffcanvasOpen;
    }

    private void CloseOffcanvas()
    {
        isOffcanvasOpen = false;
    }


    private async Task SubmitFeedback(bool isHelpful)
    {
        var authState = await authenticationStateTask!;
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var feedback = new SearchFeedback
            {
                Query = string.IsNullOrWhiteSpace(QueryParam) ? "Full Catalog" : QueryParam,
                IsHelpful = isHelpful,
                Username = user.Identity.Name ?? "Unknown"
            };

            DbContext.SearchFeedbacks.Add(feedback);
            await DbContext.SaveChangesAsync();
            
            hasSubmittedFeedback = true;
            showLoginPrompt = false; 
        }
        else
        {
            showLoginPrompt = true;
        }
    }

    private RenderFragment RenderFilterContent() => __builder =>
    {
        <div class="filter-group mb-4">
            <h6 class="eyebrow-tag mb-3">CURATED STREAMS</h6>
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-sm text-start rounded-2 p-2 @(QueryParam == "subject:self-help" ? "btn-dark" : "btn-light")" 
                        @onclick='() => ApplyCategory("subject:self-help")'>
                    <i class="bi bi-compass-fill me-2"></i> Self-Development
                </button>
                <button class="btn btn-sm text-start rounded-2 p-2 @(QueryParam == "subject:computers" ? "btn-dark" : "btn-light")" 
                        @onclick='() => ApplyCategory("subject:computers")'>
                    <i class="bi bi-code-slash me-2"></i> Programming
                </button>
                <button class="btn btn-sm text-start rounded-2 p-2 @(QueryParam == "subject:\"artificial intelligence\"" ? "btn-dark" : "btn-light")" 
                        @onclick='() => ApplyCategory("subject:\"artificial intelligence\"")'>
                    <i class="bi bi-cpu-fill me-2"></i> AI & Future
                </button>
                <button class="btn btn-sm text-start rounded-2 p-2 @(QueryParam == "subject:fiction" ? "btn-dark" : "btn-light")" 
                        @onclick='() => ApplyCategory("subject:fiction")'>
                    <i class="bi bi-book-half me-2"></i> Novel & Fiction
                </button>
                <button class="btn btn-sm text-start rounded-2 p-2 @(QueryParam == "subject:business" ? "btn-dark" : "btn-light")" 
                        @onclick='() => ApplyCategory("subject:business")'>
                    <i class="bi bi-graph-up-arrow me-2"></i> Finance & Markets
                </button>
            </div>
        </div>

        <hr style="border-color: var(--folio-sand, #e8e2d5);" />

        <div class="filter-group">
            <h6 class="eyebrow-tag mb-3">POPULAR TOPICS</h6>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn"><span class="badge bg-white text-dark border px-2 py-2 cursor-pointer rounded-pill" @onclick='() => ApplySearch("subject:history")'>History</span></button>
                <button class="btn"><span class="badge bg-white text-dark border px-2 py-2 cursor-pointer rounded-pill" @onclick='() => ApplySearch("subject:philosophy")'>Philosophy</span></button>
                <button class="btn"><span class="badge bg-white text-dark border px-2 py-2 cursor-pointer rounded-pill" @onclick='() => ApplySearch("subject:science")'>Science</span></button>
                <button class="btn"><span class="badge bg-white text-dark border px-2 py-2 cursor-pointer rounded-pill" @onclick='() => ApplySearch("subject:biography")'>Biography</span></button>
            </div>
        </div>
    };
}