@using BookRec.Models


<div class="col-12 col-sm-6 col-md-4 col-lg-3">
    <div class="folio-card h-100 d-flex flex-column justify-content-between p-3 bg-white">
        <div>
            <div
                class="book-cover-wrapper rounded p-3 text-center mb-3 d-flex align-items-center justify-content-center">
                <img src="@Book.CoverImageUrl" class="book-cover-img rounded" alt="@Book.Title" />
            </div>

            <span class="eyebrow-tag m-0 mb-1" style="font-size: 0.68rem;">@Book.Category</span>
            <h6 class="font-serif fw-bold text-dark mb-1 text-truncate" title="@Book.Title">@Book.Title</h6>
            <small class="d-block mb-2" style="color: var(--folio-slate);">by @Book.Author</small>
            <p class="small text-truncate-3 mb-0"
            style="color: var(--folio-slate); font-size: 0.825rem; line-height: 1.5;">
                @Book.Description
            </p>
        </div>

        <div class="mt-3 pt-3 border-top d-grid" style="border-color: var(--folio-sand) !important;">
            <button
                class="btn-outline-sand btn-sm text-center py-2 d-flex align-items-center justify-content-center gap-1"
                @onclick=AddToToReadList">
                <i class="bi bi-plus-lg"></i> Add to To-Read
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Book Book { get; set; } = null!;
    [Parameter]
    public EventCallback<Book> OnAddToToReadList { get; set; }

    private async Task AddToToReadList()
    {
        await OnAddToToReadList.InvokeAsync(Book);
    }
}

