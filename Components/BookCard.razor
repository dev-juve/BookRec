@using BookRec.Models
@using BookRec.Data
@using BookRec.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> DbFactory
@inject BookService BookService
@inject UserService UserService

<div class="folio-card h-100 w-100 d-flex flex-column justify-content-between p-3 bg-white cursor-pointer transition-hover" @onclick="NavigateToBook">
    <div>
        <div class="book-cover-wrapper rounded p-3 text-center mb-3 d-flex align-items-center justify-content-center">
            <img src="@Book.CoverImageUrl" class="book-cover-img rounded shadow-sm" alt="@Book.Title" width="136" height="180" loading="lazy" />
        </div>

        <span class="eyebrow-tag m-0 mb-1 text-uppercase" style="font-size: 0.68rem;">
            @(string.IsNullOrWhiteSpace(Book.DisplayCategory) ? Book.Category.ToString() : Book.DisplayCategory)
        </span>
        <h6 class="font-serif fw-bold text-dark mb-1 text-truncate" title="@Book.Title">@Book.Title</h6>
        <small class="d-block mb-2" style="color: var(--folio-slate);">
            by @(string.IsNullOrWhiteSpace(Book.Author) ? "Unknown Author" : Book.Author)
        </small>
        
        <!-- average rating display -->
        @if (reviewCount > 0)
        {
            <div class="mb-2 text-warning small d-flex align-items-center gap-1">
                <i class="bi bi-star-fill"></i>
                <span class="text-dark fw-bold ms-1">@Math.Round(averageRating, 1)</span>
                <span class="text-muted fw-normal">(@reviewCount)</span>
            </div>
        }

        <p class="small text-truncate-3 mb-0" style="color: var(--folio-slate); font-size: 0.825rem; line-height: 1.5;">
            @(string.IsNullOrWhiteSpace(Book.Description) ? "No description available for this volume." : Book.Description)
        </p>
    </div>

    <!-- stopPropagation -->
    <div class="mt-3 pt-3 border-top d-grid" style="border-color: var(--folio-sand) !important;" @onclick:stopPropagation="true">
        <button class="btn-outline-sand btn-sm text-center py-2 d-flex align-items-center justify-content-center gap-1" @onclick="AddToToReadList">
            <i class="bi bi-plus-lg"></i> Add to To-Read
        </button>
    </div>
</div>

@if (addMessage != null) 
{ 
    <!-- global floating toast notification -->
    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 1055;">
        <div class="toast show align-items-center text-white bg-success border-0 shadow-lg fade-in" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex p-1">
                <div class="toast-body d-flex align-items-center gap-2 fw-medium">
                    <i class="bi bi-check-circle-fill fs-5"></i> 
                    @addMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-3 m-auto" @onclick="() => addMessage = null" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<style>
    .cursor-pointer { cursor: pointer; }
    .transition-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .transition-hover:hover { transform: translateY(-4px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }

    .book-cover-wrapper {
        background: linear-gradient(145deg, #f3efe6, #faf8f5);
        height: 220px;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.03);
    }

    .book-cover-img {
        max-height: 180px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .folio-card:hover .book-cover-img {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
    }

    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    [Parameter]
    public Book Book { get; set; } = null!;

    private string? addMessage;
    private double averageRating = 0;
    private int reviewCount = 0;

    protected override async Task OnParametersSetAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        var bookReviews = await context.Reviews.Where(r => r.BookId == Book.GoogleBookId).ToListAsync();
        if (bookReviews.Any())
        {
            averageRating = bookReviews.Average(r => r.StarRating);
            reviewCount = bookReviews.Count;
        }
    }

    private async Task AddToToReadList()
    {
        await UserService.GetUserAsync();

        if (UserService.Id != null)
        {
            await BookService.AddToReadList(Book, UserService.Id);
            
            addMessage = $"\"{Book.Title}\" was added to your To-Read list.";
            StateHasChanged();

            await Task.Delay(5000);

            addMessage = null;
            StateHasChanged();
        }
        else
        {
            Navigation.NavigateTo("/signin", forceLoad: true);
        }
    }

    private void NavigateToBook()
    {
        if (!string.IsNullOrWhiteSpace(Book.GoogleBookId))
        {
            Navigation.NavigateTo($"/book/{Book.GoogleBookId}");
        }
    }
}