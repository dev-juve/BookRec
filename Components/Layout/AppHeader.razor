@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers
@using BookRec.Services
@implements IDisposable
@inject UserService userService
@inject BookService BookService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<header class="bg-white border-bottom py-3 px-4 sticky-top shadow-sm">
    <div class="container-fluid d-flex align-items-center justify-content-between max-w-1200">
        
        <!-- logo -->
        <a href="/" class="text-decoration-none d-flex align-items-center">
            <span class="font-serif fw-bold fs-3 text-dark tracking-tight">BookRec</span>
            <span class="ms-1 fs-4" style="color: var(--folio-terracotta);">•</span>
        </a>

        <!-- search bar -->
        <div class="position-relative flex-grow-1 mx-4 d-none d-md-block" style="max-width: 480px;">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <input type="text" 
                   id="site-search"
                   name="search"
                   class="form-control rounded-pill bg-light border-0 ps-5 pe-3 py-2 text-dark" 
                   placeholder="Search titles, authors, or literary themes..." 
                   style="font-size: 0.875rem;" 
                   @bind="SearchQuery" 
                   @bind:event="oninput"
                   @onkeyup="HandleKeyPress" />
        </div>

        <!-- auth -->
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-3">
                    <a href="/dashboard" class="text-decoration-none text-dark fw-medium small d-flex align-items-center gap-1">
                        <i class="bi bi-journal-bookmark"></i> Dashboard
                    </a>
                    <span class="text-muted">•</span>
                    <span class="fw-semibold small">@userService.Name</span>
                    <a href="/signout" target="_top" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 ms-1">Sign Out</a>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="d-flex align-items-center gap-3">
                    <a href="/signin" target="_top" class="btn-dark-solid">Sign In with GitHub</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</header>

@code {
    private string _searchQuery = string.Empty;
    private Timer? _debounceTimer;
    private Timer? _clearTimer;

    public string SearchQuery
    {
        get => _searchQuery;
        set
        {
            _searchQuery = value;
            if (_debounceTimer != null)
            {
                _debounceTimer.Stop();
                _debounceTimer.Start();
            }
        }
    }

    protected override void OnInitialized()
    {
        // 1000ms debounce for typing
        _debounceTimer = new Timer(1000);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += PerformSearch;

        // 9-second timer to clear the search input after execution
        _clearTimer = new Timer(9000);
        _clearTimer.AutoReset = false;
        _clearTimer.Elapsed += (s, e) => 
        {
            _searchQuery = string.Empty;
            InvokeAsync(StateHasChanged);
        };
    }

    private void PerformSearch(object? sender, ElapsedEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            InvokeAsync(async () => await ExecuteSearchAsync(_searchQuery));
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _debounceTimer?.Stop();
            await ExecuteSearchAsync(_searchQuery);
        }
    }

    private async Task ExecuteSearchAsync(string query)
    {
        // make sure we have the active user
        await userService.GetUserAsync();
        
        // log the search if they are signed in
        if (userService.Id != null)
        {
            await BookService.LogUserSearchAsync(userService.Id, query);
        }

        var targetUri = $"/books?q={Uri.EscapeDataString(query)}";
        if (!Navigation.Uri.EndsWith(targetUri, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(targetUri);
        }

        // start the 9-second countdown to clear search input
        _clearTimer?.Stop();
        _clearTimer?.Start();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _clearTimer?.Dispose();
    }
}