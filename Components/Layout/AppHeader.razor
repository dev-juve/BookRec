@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers
@using BookRec.Services
@implements IDisposable
@inject UserService userService
@inject BookService BookService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<style>
    /* gently reduce the search bar width on mobile screens */
    @@media (max-width: 991.98px) {
        .mobile-search-container {
            max-width: 250px !important; 
            margin-left: auto !important;
            margin-right: auto !important;
        }
    }
</style>

<header class="bg-white border-bottom sticky-top shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light py-3 px-3 px-lg-4 max-w-1200 mx-auto">
        <div class="container-fluid p-0">
            
            <!-- logo -->
            <a href="/" class="navbar-brand d-flex align-items-center m-0">
                <span class="font-serif fw-bold fs-3 text-dark tracking-tight">BookRec</span>
                <span class="ms-1 fs-4" style="color: var(--folio-terracotta);">•</span>
            </a>

            <!-- search bar -->
            <div class="position-relative flex-grow-1 mx-3 mx-lg-4 mobile-search-container" style="max-width: 480px;">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" 
                       id="site-search"
                       name="search"
                       class="form-control rounded-pill bg-light border-0 ps-5 pe-3 py-2 text-dark w-100" 
                       placeholder="Search titles, authors, or literary themes..." 
                       style="font-size: 0.875rem; text-overflow: ellipsis;" 
                       @bind="SearchQuery" 
                       @bind:event="oninput"
                       @onkeyup="HandleKeyPress" />
            </div>

            <!-- mobile toggler (hamburger menu) - FIXED WITH ARIA-LABEL -->
            <button class="navbar-toggler border-0 p-1 ms-1" type="button" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)" aria-label="Toggle navigation menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- nav scetion -->
            <div class="@NavMenuCssClass navbar-collapse mt-3 mt-lg-0" id="navbarContent">
                
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2" @onclick="CloseNavMenu">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" href="/books">Catalog</a>
                    </li>
                    
                    <!-- subjects dropdown -->
                    <li class="nav-item dropdown" @onclick:stopPropagation>
                        <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" @onclick="ToggleDropdown" @onclick:preventDefault aria-expanded="@isDropdownOpen">
                            Subjects
                        </a>
                        <ul class="dropdown-menu border-0 shadow-sm @(isDropdownOpen ? "show" : "")">
                            <li><a class="dropdown-item" href="/books?q=subject:fiction" @onclick="CloseNavMenu">Fiction</a></li>
                            <li><a class="dropdown-item" href="/books?q=subject:business" @onclick="CloseNavMenu">Business</a></li>
                            <li><a class="dropdown-item" href="/books?q=subject:programming" @onclick="CloseNavMenu">Programming</a></li>
                            <li><a class="dropdown-item" href="/books?q=subject:history" @onclick="CloseNavMenu">History</a></li>
                            <li><a class="dropdown-item" href="/books?q=subject:self-development" @onclick="CloseNavMenu">Self-Development</a></li>
                        </ul>
                    </li>
    
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" href="/editorial">About</a>
                    </li>
                </ul>

                <!-- auth section -->
                <div class="d-flex align-items-center ms-lg-3 mt-3 mt-lg-0" @onclick="CloseNavMenu">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-3 w-100">
                                <a href="/dashboard" class="text-decoration-none text-dark fw-medium small d-flex align-items-center gap-1">
                                    <i class="bi bi-journal-bookmark"></i> Dashboard
                                </a>
                                <span class="d-none d-lg-inline text-muted">•</span>
                                <span class="fw-semibold small d-none d-lg-inline">@userService.Name</span>
                                <a href="/signout" target="_top" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1">Sign Out</a>
                            </div>
                        </Authorized>

                        <NotAuthorized>
                            <div class="w-100">
                                <a href="/signin" target="_top" class="btn-dark-solid d-block text-center">Sign In with GitHub</a>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

            </div>
        </div>
    </nav>
</header>

@code {
    private string _searchQuery = string.Empty;
    private Timer? _debounceTimer;
    private Timer? _clearTimer;
    
    // --- navigation state ---
    private bool collapseNavMenu = true;
    private bool isDropdownOpen = false;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : "";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
        isDropdownOpen = false;
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    public string SearchQuery
    {
        get => _searchQuery;
        set
        {
            _searchQuery = value;
            if (_debounceTimer != null)
            {
                _debounceTimer.Stop();
                _debounceTimer.Start();
            }
        }
    }

    protected override void OnInitialized()
    {
        // 1000ms debounce for typing
        _debounceTimer = new Timer(1000);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += PerformSearch;

        // 9-second timer to clear the search input after execution
        _clearTimer = new Timer(9000);
        _clearTimer.AutoReset = false;
        _clearTimer.Elapsed += (s, e) => 
        {
            _searchQuery = string.Empty;
            InvokeAsync(StateHasChanged);
        };
    }

    private void PerformSearch(object? sender, ElapsedEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            InvokeAsync(async () => await ExecuteSearchAsync(_searchQuery));
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _debounceTimer?.Stop();
            await ExecuteSearchAsync(_searchQuery);
        }
    }

    private async Task ExecuteSearchAsync(string query)
    {
        await userService.GetUserAsync();
        
        if (userService.Id != null)
        {
            await BookService.LogUserSearchAsync(userService.Id, query);
        }

        var targetUri = $"/books?q={Uri.EscapeDataString(query)}";
        if (!Navigation.Uri.EndsWith(targetUri, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(targetUri);
        }

        CloseNavMenu();

        _clearTimer?.Stop();
        _clearTimer?.Start();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _clearTimer?.Dispose();
    }
}